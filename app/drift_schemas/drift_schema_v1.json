  "fixed_sql": [
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"base_set_version\" INTEGER NOT NULL, \"rule_version\" INTEGER NOT NULL, \"memo_unlocked_at\" INTEGER, \"glyph_revision\" INTEGER NOT NULL DEFAULT 0, \"base_revision\" INTEGER NOT NULL DEFAULT 0, \"font_family_name\" TEXT NOT NULL, \"font_ascii_name\" TEXT NOT NULL, \"font_style_name\" TEXT NOT NULL DEFAULT 'Regular', \"font_version_minor\" INTEGER NOT NULL DEFAULT 0 CHECK (font_version_minor BETWEEN 0 AND 999), \"font_license\" TEXT NOT NULL DEFAULT '');"
        }
      ]
    },
    {
      "name": "base_glyphs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"base_glyphs\" (\"project_id\" TEXT NOT NULL REFERENCES projects(id)ON DELETE CASCADE, \"role_key\" TEXT NOT NULL, \"strokes\" BLOB NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY(project_id, role_key));"
        }
      ]
    },
    {
      "name": "custom_revisions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_revisions\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"project_id\" TEXT NOT NULL REFERENCES projects(id)ON DELETE CASCADE, \"code_point\" INTEGER NOT NULL CHECK (code_point BETWEEN 44032 AND 55203), \"strokes\" BLOB NOT NULL, \"outline\" BLOB NOT NULL, \"pen\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, UNIQUE(project_id, code_point, id));"
        }
      ]
    },
    {
      "name": "custom_revisions_cp",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX custom_revisions_cp ON custom_revisions (project_id, code_point)"
        }
      ]
    },
    {
      "name": "custom_glyphs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"custom_glyphs\" (\"project_id\" TEXT NOT NULL REFERENCES projects(id)ON DELETE CASCADE, \"code_point\" INTEGER NOT NULL CHECK (code_point BETWEEN 44032 AND 55203), \"selection\" TEXT NOT NULL CHECK (selection IN ('generated', 'custom')), \"current_revision_id\" INTEGER NOT NULL, PRIMARY KEY(project_id, code_point), FOREIGN KEY(project_id, code_point, current_revision_id)REFERENCES custom_revisions(project_id, code_point, id));"
        }
      ]
    },
    {
      "name": "memos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"memos\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"project_id\" TEXT NOT NULL REFERENCES projects(id)ON DELETE CASCADE, \"text\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "drafts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drafts\" (\"project_id\" TEXT NOT NULL REFERENCES projects(id)ON DELETE CASCADE, \"kind\" TEXT NOT NULL CHECK (kind IN ('base', 'custom')), \"key\" TEXT NOT NULL, \"strokes\" BLOB NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY(project_id, kind, \"key\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"key\" TEXT NOT NULL PRIMARY KEY, \"value\" TEXT NOT NULL);"
        }
      ]
    },
    {
      "name": "revision_guard",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"revision_guard\" (\"id\" INTEGER NOT NULL PRIMARY KEY CHECK (id = 1), \"allow_revision_delete\" INTEGER NOT NULL CHECK (allow_revision_delete IN (0, 1)));"
        }
      ]
    },
    {
      "name": "custom_revisions_no_delete",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER custom_revisions_no_delete BEFORE DELETE ON custom_revisions WHEN NOT EXISTS (SELECT 1 FROM revision_guard WHERE id = 1 AND allow_revision_delete = 1) BEGIN SELECT RAISE (ABORT, 'custom revision delete not allowed');END"
        }
      ]
    }
  ]
